page = [f'<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
        f"<title>Audit of {html.escape(title)}</title><style>{CSS}</style></head><body><main>",
        f"<h1>Audit of {html.escape(title)}</h1>",
        render(header) if header else "<p><em>No header was written.</em></p>",
        '<div class="lead">' + (render(summary) if summary else "<p><em>No summary was written.</em></p>") + "</div>",
        "<nav>" + "".join(f'<a href="#s{h[0]}">{html.escape(h)}</a>' for _, h in SECTIONS) + "</nav>",
        f'<p class="note">{inline(NOTE)}</p>']
for name, heading in SECTIONS:
    body = PARTS[name]
    page.append(f'<h2 id="s{heading[0]}">{html.escape(heading)}</h2>')
    page.append(render(body) if body else "<p><em>Nothing was written for this section.</em></p>")
page.append("<footer>Written by agents from outside the repository, which was neither changed nor run. Every citation can be checked against the repository.</footer></main></body></html>")


def write(name, text):
    path = D / name
    if path.is_symlink(): sys.exit(f"build-report: {name} is a link")
    tmp = D / (name + ".tmp")
    try: os.unlink(tmp)
    except FileNotFoundError: pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)   # a new file, never one found there
    with os.fdopen(fd, "w", encoding="utf-8") as f: f.write(text + "\n")
    os.replace(tmp, path)


write("report.md", markdown)
write("report.html", "\n".join(page))
print(f"wrote {D / 'report.md'} and {D / 'report.html'}")
print("report.html is the one to open or send: report.md keeps the parts as written, for check-report.")
if missing: print("not written, or too large: " + ", ".join(missing))
