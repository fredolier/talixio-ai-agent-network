#!/usr/bin/env bash
# Clones (or updates) a repository for reading only, for an audit agent.
#   fetch-repo <dir> <https-url> [branch-or-commit]
# The files land in <dir>/<name>, read-only. The git data (objects, configuration) is kept
# apart, under the account's state directory, where no agent tool writes: an agent that can
# write in <dir> cannot make git run anything. Nothing from the repository is ever run: no
# hook, no filter, no submodule, no LFS download; a link in the repository is written as a
# plain file. No remote is recorded: nothing can be pushed.
# A private repository needs a read-only token in $AUDIT_READ_TOKEN (and $AUDIT_READ_USER for a
# deploy token), with $AUDIT_READ_URL, the address prefix the token is for
# (https://gitlab.example.com/group/): the token is offered to no other address. It reaches git
# through a credential helper that names the variable: its value is never on a command line,
# in a configuration or in a file.
# Adapted from scripts/fetch.sh of Talixio AI Claude Auditor.
set -euo pipefail
refuse() { echo "fetch-repo: $*" >&2; exit 2; }

tok="${AUDIT_READ_TOKEN:-}"; usr="${AUDIT_READ_USER:-oauth2}"; bound="${AUDIT_READ_URL:-}"
unset AUDIT_READ_TOKEN AUDIT_READ_USER AUDIT_READ_URL   # only the network command gets the token

[[ $# -eq 2 || $# -eq 3 ]] || refuse "usage: fetch-repo <dir> <https-url> [branch-or-commit]"
dir="$1"; url="$2"; ref="${3:-}"
[[ -d "$dir" && ! -L "$dir" ]] || refuse "$dir is not a directory"
# https only, a plain host name (not a number), no account, no port, no odd character
[[ "$url" =~ ^https://([a-z0-9]([a-z0-9.-]*[a-z0-9])?)(/[A-Za-z0-9._~/-]+)$ ]] || refuse "need an https:// address with no account, port or query in it"
host="${BASH_REMATCH[1]}"
[[ "$host" == *.* && "$host" =~ [a-z] && "$url" != *..* ]] || refuse "address refused"
[[ -z "$ref" || "$ref" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$ ]] || refuse "branch or commit refused"
[[ "$ref" != *..* ]] || refuse "branch or commit refused"

name="$(basename "${url%/}" .git | tr -c 'A-Za-z0-9._\n-' '_')"
[[ -n "$name" && "$name" != .* ]] || refuse "no usable name in the address"
dir="$(cd "$dir" && pwd -P)"
dest="$dir/$name"

# the git data: outside everything an agent is given
[[ -n "${HOME:-}" && -d "$HOME" ]] || refuse "no home directory to keep the git data in"
state="$(cd "$HOME" && pwd -P)/.local/state/talixio-audit"
[[ "$state/" != "$dir/"* && "$dir/" != "$state/"* ]] || refuse "$dir holds, or is inside, the directory of the git data"
store="$state/$(printf %s "$dest" | sha256sum | cut -c1-40).git"

ulimit -v 4194304 2>/dev/null || true   # 4 GiB of memory
ulimit -f 4194304 2>/dev/null || true   # no file above 4 GiB
export GIT_TERMINAL_PROMPT=0        # fail instead of asking for a password
export GIT_ALLOW_PROTOCOL=https     # no ssh, file or ext transport
export GIT_LFS_SKIP_SMUDGE=1        # no extra download
safe=(-c core.hooksPath=/dev/null -c core.fsmonitor=false -c core.symlinks=false -c core.pager=cat
      -c core.packedGitLimit=512m -c core.packedGitWindowSize=64m -c credential.helper=)
g() { timeout --foreground -k 5 "${limit:-60}" git --git-dir="$store" "${safe[@]}" "$@"; }

fresh=""
cleanup() { [[ -z "$fresh" ]] || { chmod -R u+w "$dest" 2>/dev/null; rm -rf "$store" "$dest"; }; }
trap cleanup EXIT
if [[ -d "$store" ]]; then
  [[ -d "$dest" && ! -L "$dest" ]] || refuse "$dest is missing: remove nothing by hand, ask for another directory"
  [[ "$(cat "$store/audit-origin" 2>/dev/null)" == "$url" ]] || refuse "$dest was not fetched from this address"
else
  [[ ! -e "$dest" && ! -L "$dest" ]] || refuse "$dest exists and was not made by fetch-repo"
  mkdir -p -m 700 "$state"
  [[ -O "$state" && ! -L "$state" ]] || refuse "the directory of the git data belongs to someone else"
  fresh=1
  git init --quiet --bare "$store"
  mkdir "$dest"
  printf '%s\n' "$url" > "$store/audit-origin"
fi

cred=()
if [[ -n "$tok" ]]; then
  [[ "$bound" =~ ^https://[a-z0-9.-]+/ && "$url/" == "$bound"* ]] || refuse "the token is not for this address"
  helper='!f() { test "$1" = get && printf "username=%s\npassword=%s\n" "$AUDIT_READ_USER" "$AUDIT_READ_TOKEN"; }; f'
  cred=(-c credential.useHttpPath=true -c "credential.$bound.helper=$helper")   # git matches host and path prefix itself
fi
# under the 120 s the agent gives a command; a larger repository takes several calls to finish
AUDIT_READ_TOKEN="$tok" AUDIT_READ_USER="$usr" limit=110 g "${cred[@]}" -c http.followRedirects=false -c transfer.fsckObjects=true \
  -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 \
  fetch --quiet --no-tags --no-recurse-submodules -- "$url" '+refs/heads/*:refs/remotes/origin/*' '+HEAD:refs/remotes/origin/HEAD' \
  || refuse "the fetch failed or was too long (access refused, wrong address, or a repository too large: run it again to continue)"

if [[ -z "$ref" ]]; then ref="origin/HEAD"
elif g rev-parse -q --verify "origin/$ref^{commit}" >/dev/null; then ref="origin/$ref"; fi
g rev-parse -q --verify "$ref^{commit}" >/dev/null || refuse "no such branch or commit"
chmod -R u+w "$dest"
g --work-tree="$dest" checkout --quiet --force --detach "$ref" --
find "$dest" -type f -exec chmod a-w {} +   # working files read-only
fresh=""

echo "target:  $dest"
echo "commit:  $(g rev-parse HEAD)  ($(g log -1 --format=%as))"
