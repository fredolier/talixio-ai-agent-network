#!/usr/bin/env bash
# Opens an audit report: a new directory with one file for each part of the report, each holding
# what its writer fills in. One file per part, so that no agent writes over another's work;
# build-report puts them together.
#   new-report <new directory>
set -euo pipefail
[[ $# -eq 1 && "$1" != -* ]] || { echo "new-report: usage: new-report <new directory>" >&2; exit 2; }
[[ ! -e "$1" && ! -L "$1" ]] || { echo "new-report: $1 already exists" >&2; exit 2; }
mkdir -- "$1"
out=""
while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ "$line" =~ ^'<!-- part: '([0-9a-z-]+\.md)' -->'$ ]]; then out="$1/${BASH_REMATCH[1]}"; ( set -o noclobber; : > "$out" )   # a new file, never one found there
  elif [[ -n "$out" ]]; then printf '%s\n' "$line" >> "$out"; fi
done < "$(dirname "$(readlink -f "$0")")/report.md"
echo "wrote $1: $(ls -- "$1" | tr '\n' ' ')"
